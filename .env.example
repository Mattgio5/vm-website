# Copy this file to .env.local for local dev, and set the same values in
# your Vercel project settings (Production + Preview) for deploy.

# ---------------------------------------------------------------------------
# Supabase (server-side writes from /api/lead-intake)
# ---------------------------------------------------------------------------
# Project URL — the Vercel↔Supabase integration auto-creates
# NEXT_PUBLIC_SUPABASE_URL, so you can usually skip this line. If you set
# both, SUPABASE_URL wins.
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Public anon key auto-created by the Vercel↔Supabase integration. Our
# server-side code does NOT use this, but it's fine to leave in place.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...

# Service role key — server-side only. NEVER prefix with NEXT_PUBLIC_.
# Get it from: Supabase dashboard → Project Settings → API → "service_role"
# (click Reveal). This key bypasses RLS, which is required because the
# quote_requests table is locked down to deny anon writes.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key...

# ---------------------------------------------------------------------------
# Mapbox address autocomplete (browser-side, public token)
# ---------------------------------------------------------------------------
# Get from: account.mapbox.com → Tokens → either use the default public
# token or create one scoped to your domain.
#
# Lock it down: Mapbox dashboard → click the token → URL restrictions →
# add https://varsitymulching.com/* and https://*.vercel.app/*
#
# If this is unset, the address fields gracefully fall back to plain text
# inputs and the forms still work — just without suggestions.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.eyJ1...

# ---------------------------------------------------------------------------
# Calendly event URLs per service zone (browser-side, public)
# ---------------------------------------------------------------------------
# The Flask quote-scheduler routes leads to one of five URL paths on this
# site (`/schedule-central-bucks`, `-south-bucks`, `-montco-west`,
# `-north-bucks`, `-general`). Each path embeds one of these Calendly event
# URLs. Leave blank to fall back to the default URL coded in
# lib/scheduling.ts (currently https://calendly.com/matt-giordano/15min).
NEXT_PUBLIC_CALENDLY_CENTRAL_BUCKS=https://calendly.com/matt-giordano/15min
NEXT_PUBLIC_CALENDLY_SOUTH_BUCKS=
NEXT_PUBLIC_CALENDLY_MONTCO_WEST=
NEXT_PUBLIC_CALENDLY_NORTH_BUCKS=
NEXT_PUBLIC_CALENDLY_GENERAL=

# ---------------------------------------------------------------------------
# Quote scheduler (Flask backend that handles Jobber + Calendly routing)
# ---------------------------------------------------------------------------
# Leave unset to use the default production URL baked into the API route.
# Override to point at a local Flask dev server (e.g. http://localhost:5000/public/lead-intake)
# or a staging instance during testing.
# QUOTE_SCHEDULER_API_URL=https://quote-scheduler-0fwk.onrender.com/public/lead-intake
