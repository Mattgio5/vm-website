# Copy this file to .env.local for local dev, and set the same values in
# your Vercel project settings (Production + Preview) for deploy.

# ---------------------------------------------------------------------------
# Supabase (server-side writes from /api/lead-intake)
# ---------------------------------------------------------------------------
# From: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Service role key — server-side only. NEVER prefix with NEXT_PUBLIC_.
# This key bypasses RLS, which is required because the public form needs
# to write to a table that's otherwise locked down.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key...

# ---------------------------------------------------------------------------
# Quote scheduler (Flask backend that handles Jobber + Calendly routing)
# ---------------------------------------------------------------------------
# Leave unset to use the default production URL baked into the API route.
# Override to point at a local Flask dev server (e.g. http://localhost:5000/public/lead-intake)
# or a staging instance during testing.
# QUOTE_SCHEDULER_API_URL=https://quote-scheduler-0fwk.onrender.com/public/lead-intake
